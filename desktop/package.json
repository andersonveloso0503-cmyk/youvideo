{
  "name": "youvideo-compilador",
  "productName": "Youvideo Compilador",
  "version": "1.2.0",
  "description": "Compilações de músicas com onda de áudio, legenda e publicação no YouTube — gera tudo no próprio PC.",
  "author": "Anderson Veloso",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "teste": "node teste/teste-motor.js"
  },
  "dependencies": {
    "@fal-ai/client": "1.10.1",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "googleapis": "144.0.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.youvideo.compilador",
    "productName": "Youvideo Compilador",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "assets/fonts/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Youvideo-Compilador-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Youvideo Compilador"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andersonveloso0503-cmyk/youvideo.git"
  }
}